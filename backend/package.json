{
  "name": "pling-backend",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "npm run build && node dist/src/migrate.js",
    "start": "node dist/src/main.js",
    "dev": "npm run build && node --env-file=.env dist/src/main.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
