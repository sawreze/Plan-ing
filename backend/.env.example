# Copy with: npm run setup:local (generates random local secrets)
NODE_ENV=development
AUTH_MODE=local
AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://pling:replace-password@127.0.0.1:54329/pling
POSTGRES_PASSWORD=replace-password
PORT=8080
HOST=127.0.0.1
CORS_ORIGINS=
# For Supabase auth, set AUTH_MODE=supabase and configure the actual project.
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Gemini stays unavailable until both values are supplied.
GEMINI_API_KEY=
GEMINI_MODEL=
# iOS remote push worker: server-only Apple credentials.
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_SANDBOX=true
